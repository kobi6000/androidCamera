<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    tools:context=".SecondFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_blue"
            app:cornerRadius="24dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- About Description -->
        <TextView
            android:id="@+id/about_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/about_description"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/back_button" />

        <!-- Features Title -->
        <TextView
            android:id="@+id/features_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/features_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/about_description" />

        <!-- Feature 1 -->
        <TextView
            android:id="@+id/feature_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/feature_camera"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/features_title" />

        <!-- Feature 2 -->
        <TextView
            android:id="@+id/feature_properties"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/feature_properties"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/feature_camera" />

        <!-- Feature 3 -->
        <TextView
            android:id="@+id/feature_wifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/feature_wifi"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/feature_properties" />

        <!-- Feature 4 -->
        <TextView
            android:id="@+id/feature_secure"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/feature_secure"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/feature_wifi" />

        <!-- Usage Title -->
        <TextView
            android:id="@+id/usage_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/usage_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/feature_secure" />

        <!-- Usage Step 1 -->
        <TextView
            android:id="@+id/usage_step1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/usage_step1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/usage_title" />

        <!-- Usage Step 2 -->
        <TextView
            android:id="@+id/usage_step2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/usage_step2"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/usage_step1" />

        <!-- Usage Step 3 -->
        <TextView
            android:id="@+id/usage_step3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/usage_step3"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/usage_step2" />

        <!-- Usage Step 4 -->
        <TextView
            android:id="@+id/usage_step4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/usage_step4"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/usage_step3" />

        <!-- About Footer -->
        <TextView
            android:id="@+id/about_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/about_footer"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/usage_step4"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>