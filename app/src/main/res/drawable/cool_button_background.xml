<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/gradient_end"
                android:endColor="@color/gradient_start"
                android:angle="45" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="@color/primary_cyan" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_tertiary" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/gradient_start"
                android:endColor="@color/gradient_end"
                android:angle="45" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/primary_blue" />
        </shape>
    </item>
</selector> 